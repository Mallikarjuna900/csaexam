<!DOCTYPE html>
<html>
<head>
    <title>OUR DREAMS - CSA EXAM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: Arial; padding: 20px; max-width: 700px; margin: auto; }
        .header { background: #007bff; color: white; padding: 15px; text-align: center; border-radius: 8px; }
        .question { margin: 20px 0; padding: 15px; border: 2px solid #007bff; border-radius: 8px; }
        button { padding: 12px 20px; margin: 5px; font-size: 16px; cursor: pointer; border-radius: 5px; }
        .submit { background: green; color: white; }
        .reset { background: red; color: white; }
    </style>
</head>
<body>

<div class="header">
    <h1>OUR DREAMS - CSA EXAM</h1>
    <p>Time: 8:00 AM to 8:00 PM Only</p>
</div>

<form>
    <h3>Student Details:</h3>
    Name: <input type="text" id="sName" required><br><br>
    Last 4 Digits: <input type="text" id="sID" required><br><br>
    
    <div class="question">
        <p><b>1. CSA అంటే ఏమిటి?</b></p>
        <input type="radio" name="q1" value="A"> A) Computer Service<br>
        <input type="radio" name="q1" value="B"> B) Customer Service Associate<br>
        <input type="radio" name="q1" value="C"> C) Common Service Agent<br>
    </div>

    <div class="question">
        <p><b>2. HTML Full Form?</b></p>
        <input type="radio" name="q2" value="A"> A) Hyper Text Markup Language<br>
        <input type="radio" name="q2" value="B"> B) High Tech Modern Language<br>
    </div>

    <button type="button" class="submit" onclick="submitExam()">Submit Exam</button>
    <button type="button" class="reset" onclick="resetExam()">Reset & Start Fresh</button>
</form>

<script>
// 8AM-8PM CHECK
var hours = new Date().getHours();
if(hours < 8 || hours >= 20) {
    document.body.innerHTML = '<h1 style="text-align:center;margin-top:100px;">Exam Closed<br>Time: 8:00 AM to 8:00 PM Only</h1>';
}

// AUTO SAVE
document.addEventListener('input', function() {
    var data = {
        name: document.getElementById('sName').value,
        id: document.getElementById('sID').value,
        q1: document.querySelector('input[name="q1"]:checked')?.value || '',
        q2: document.querySelector('input[name="q2"]:checked')?.value || ''
    };
    localStorage.setItem('ourDreamsData', JSON.stringify(data));
});

// AUTO LOAD
window.onload = function() {
    var saved = JSON.parse(localStorage.getItem('ourDreamsData') || '{}');
    if(saved.name) document.getElementById('sName').value = saved.name;
    if(saved.id) document.getElementById('sID').value = saved.id;
    if(saved.q1) document.querySelector(`input[name="q1"][value="${saved.q1}"]`).checked = true;
    if(saved.q2) document.querySelector(`input[name="q2"][value="${saved.q2}"]`).checked = true;
    if(saved.name) alert('Welcome back! Your saved answers are restored.');
};

function submitExam() {
    var score = 0;
    if(document.querySelector('input[name="q1"]:checked')?.value === 'B') score++;
    if(document.querySelector('input[name="q2"]:checked')?.value === 'A') score++;
    alert('Exam Submitted!\nName: ' + document.getElementById('sName').value + '\nScore: ' + score + '/2');
    localStorage.removeItem('ourDreamsData');
    location.reload();
}

function resetExam() {
    localStorage.removeItem('ourDreamsData');
    alert('All data cleared. Starting Fresh!');
    location.reload();
}
</script>

</body>
</html>
